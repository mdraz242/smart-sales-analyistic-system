# Environment Configuration for WooCommerce B2C Sales Intelligence Platform

# Application Mode & Secret Key
APP_ENV=development
APP_SECRET_KEY=generate_a_random_32_byte_secret_key_here
LOG_LEVEL=INFO

# Database Connection
# SQLite for local development:
DATABASE_URL=sqlite:///./woocommerce_analytics.db
# PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/wc_analytics

# WooCommerce Store Settings (Optional defaults - can also be configured via UI)
WC_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_API_VERSION=wc/v3
WC_VERIFY_SSL=True
WC_TIMEOUT_SECONDS=30
WC_MAX_RETRIES=3

# Store Regional Defaults
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# AI Report Integration (Optional - provider independent)
# Supports 'openai', 'gemini', 'anthropic', or 'mock' (default if no key provided)
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Server & Dashboard Ports
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
